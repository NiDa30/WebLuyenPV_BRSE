# Template only; the app reads process variables, not this file automatically.
# Configure credentials securely in environment settings. Never use VITE_ for keys.
BRSE_AI_ENABLED=false
BRSE_AI_KEY=
BRSE_AI_MODEL=gpt-4.1-mini
BRSE_API_ADDRESS=127.0.0.1
BRSE_API_PORT=8080
# Set only when the browser's actual HTTPS origin differs from the backend scheme/Host.
BRSE_ALLOWED_ORIGIN=

# Enable only after reviewing current Jisho access/content terms and network access.
BRSE_JISHO_ENABLED=false
